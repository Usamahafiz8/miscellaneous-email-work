generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model EmailSummary {
  emailId        String   @id
  from           String
  subject        String
  date           String
  summary        String
  keyPoints      String[]
  sentiment      String
  category       String
  priority       String
  priorityRank   Int      @default(2) // Critical=0, High=1, Medium=2, Low=3 — lets Prisma orderBy sort priority correctly (plain string sort would go alphabetical)
  actionRequired String
  purpose        String
  body           String?
  htmlBody       String?
  attachments       String?  // JSON: EmailAttachment[]
  attachmentSummary String?  // AI-generated summary of PDF attachment content
  status            String   @default("New")
  stage             String   @default("New") // hiring pipeline folder — only meaningful when category="Hiring"
  tags              String[] @default([])    // free-form, user-added, any email

  // Structured candidate profile — scalar columns (not a Json blob) so the
  // Candidate Sheet can render/sort/filter each field directly, the same way
  // keyPoints already works. Populated by the AI batch prompt for Hiring
  // emails (with or without a PDF attachment); null for everything else.
  candidateName         String?
  candidateRole         String?
  candidateExperience   String?
  candidateSkills       String[] @default([])
  candidateEducation    String?
  candidateAchievements String?

  // AI-extracted employment/logistics details, for matching against a
  // JobPosting's requirements on the /jobs page. Same free-text philosophy
  // as candidateRole/candidateExperience — too varied for enums.
  candidateEmploymentStatus String?
  candidateNoticePeriod     String?
  candidateLocation         String?
  candidateEmploymentType   String?

  fetchedAt      DateTime @default(now())

  matches CandidateMatch[]

  @@index([date(sort: Desc)])
  @@index([category])
  @@index([priorityRank])
  @@index([status])
  @@index([actionRequired])
  @@index([stage])
  @@map("email_summaries")
}

// A saved job posting on the /jobs page — HR pastes a job description, AI
// extracts structured requirements below, HR can edit/add to them, then
// scans all Hiring candidates for a match score (see CandidateMatch).
model JobPosting {
  id             String  @id @default(cuid())
  title          String
  jobDescription String?

  minExperienceYears       Int?
  maxExperienceYears       Int?
  techStack                String[] @default([])
  skills                   String[] @default([])
  requiredEmploymentStatus String?
  requiredNoticePeriod     String?
  requiredLocation         String?
  requiredEmploymentType   String?
  otherCriteria            String?

  lastScannedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matches CandidateMatch[]

  @@map("job_postings")
}

// One AI-computed match result for a (JobPosting, candidate email) pair.
// Re-scanning a job upserts these rows rather than duplicating them.
model CandidateMatch {
  id           String       @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  emailId      String
  emailSummary EmailSummary @relation(fields: [emailId], references: [emailId], onDelete: Cascade)

  matchScore     Int
  recommendation String // "Yes" | "No" — plain string, matching this codebase's
                         // existing convention (Category/Priority/Sentiment aren't native enums either)
  reasoning      String
  matchedAt      DateTime @default(now())

  @@unique([jobPostingId, emailId])
  @@index([jobPostingId, matchScore])
  @@map("candidate_matches")
}
